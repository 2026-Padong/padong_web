# Kakao Maps JavaScript API key (지도용)
# 1) https://developers.kakao.com 가입 → 애플리케이션 추가
# 2) 플랫폼 > Web > 사이트 도메인에 http://localhost:5173 추가
# 3) 앱 키 > JavaScript 키 복사
VITE_KAKAO_MAP_KEY=your_kakao_javascript_key_here

# 백엔드 API 베이스 URL (Spring 서버)
# Kakao OAuth는 백엔드(Spring Security OAuth2)가 전 과정 처리하므로
# 프론트엔드 env에 Kakao REST API key / Client Secret 불필요
VITE_API_BASE_URL=http://localhost:8080
