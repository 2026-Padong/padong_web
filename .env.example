# ─────────────────────────────────────────────────────────────
# 백엔드 API 베이스 URL (Spring 서버) — 필수
#   로컬:  http://localhost:8080
#   운영:  https://api.padong.io   (실제 백엔드 도메인으로 교체)
# 미설정 시 dev 는 localhost:8080 fallback, prod 는 same-origin (=깨짐)
# ─────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080

# ─────────────────────────────────────────────────────────────
# MSW 모킹 활성/비활성
#   false  → 실 백엔드 사용 (운영 필수)
#   true / 미설정 → MSW 가 일부 endpoint 가로챔 (개발 편의)
# ─────────────────────────────────────────────────────────────
VITE_USE_MOCKS=false

# ─────────────────────────────────────────────────────────────
# Kakao Maps JavaScript API key — 필수
# 1) https://developers.kakao.com → 애플리케이션
# 2) 플랫폼 > Web > 사이트 도메인 등록 (로컬+운영 둘 다)
# 3) 앱 키 > JavaScript 키 복사
# ⚠️ 절대 Client Secret 이나 REST API Key 를 프론트 env 에 두지 말 것
#    (Vite 가 빌드 시 번들에 inline → 노출됨. OAuth 는 백엔드 전담)
# ─────────────────────────────────────────────────────────────
VITE_KAKAO_MAP_KEY=your_kakao_javascript_key_here

# ─────────────────────────────────────────────────────────────
# Kakao 로그인 Redirect URI — 필수
#   로컬:  http://localhost:5173/auth/kakao/callback
#   운영:  https://your-domain.com/auth/kakao/callback
# Kakao Developers 콘솔의 Redirect URI 목록과 정확히 일치해야 함
# ─────────────────────────────────────────────────────────────
VITE_KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao/callback

# ─────────────────────────────────────────────────────────────
# PortOne v2 — 결제 위젯 SDK 키
#   테스트:  https://portone.io 가입 → 테스트 머천트
#   운영:    프로덕션 머천트로 별도 발급 후 교체 + 도메인 등록
# ─────────────────────────────────────────────────────────────
VITE_PORTONE_STORE_ID=store-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_PORTONE_CHANNEL_KEY=channel-key-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
